# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Your Postgres database (it needs the pgvector extension; a free Neon project works)
DATABASE_URL=postgresql://user:password@host/dbname

# A long random string that signs login tokens.
# Make one with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

OPENAI_API_KEY=sk-your-key-here

# Local development: read files inside the upload request (no Redis, no worker).
# Celery workers do not run on Windows, so keep this on there.
CELERY_EAGER=1

# --- Production only ---------------------------------------------------------------
# REDIS_URL=redis://...                   queue for background file reading
# FRONTEND_URL=https://your-site.vercel.app    allowed website address (comma-separate several)
# SEARCH_MODE=hybrid                      vector | hybrid | rerank   (rerank needs about 180 MB more memory)
# RERANK_MODEL=ms-marco-TinyBERT-L-2-v2   only used when SEARCH_MODE=rerank
# RATE_LIMITS=on                          set to off only for local experiments

# --- Tests only --------------------------------------------------------------------
# A separate throwaway database (for example a Neon branch). The tests refuse to run
# if this is the same database as DATABASE_URL.
# TEST_DATABASE_URL=postgresql://user:password@host/test_dbname
